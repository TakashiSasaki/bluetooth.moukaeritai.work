rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // -------------------------------------------------------------------------
    // Global Safety Net
    // -------------------------------------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }

    // -------------------------------------------------------------------------
    // Global Helpers
    // -------------------------------------------------------------------------
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      // Since anonymous authentication doesn't have verified emails, we allow any valid authenticated user
      return isSignedIn();
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidMacAddress(address) {
      return address is string 
          && address.size() == 17 
          && address.matches('^[0-9A-Fa-f]{2}(:[0-9A-Fa-f]{2}){5}$');
    }

    function isValidBluetoothDevice(item) {
      return item is map
          && item.keys().hasAll(['name', 'address'])
          && item.keys().hasOnly(['name', 'address', 'type', 'firstConnectedAt', 'lastConnectedAt', 'lastDisconnectedAt', 'isConnected'])
          && item.name is string
          && item.name.size() > 0
          && item.name.size() <= 100
          && isValidMacAddress(item.address)
          && (!item.keys().hasAny(['type']) || (item.type is string && (item.type == 'AUDIO' || item.type == 'COMPUTER' || item.type == 'PHONE' || item.type == 'WEARABLE' || item.type == 'OTHER')))
          && (!item.keys().hasAny(['firstConnectedAt']) || (item.firstConnectedAt is int || item.firstConnectedAt is float))
          && (!item.keys().hasAny(['lastConnectedAt']) || (item.lastConnectedAt is int || item.lastConnectedAt is float))
          && (!item.keys().hasAny(['lastDisconnectedAt']) || (item.lastDisconnectedAt is int || item.lastDisconnectedAt is float))
          && (!item.keys().hasAny(['isConnected']) || item.isConnected is bool);
    }

    function validateConnectedDevices(connected) {
      return connected is list 
          && connected.size() <= 20
          && (connected.size() == 0 || isValidBluetoothDevice(connected[0]));
    }

    function validateAllDevices(all) {
      return all is list 
          && all.size() <= 50
          && (all.size() == 0 || isValidBluetoothDevice(all[0]));
    }

    // -------------------------------------------------------------------------
    // Validation Blueprints (Anti-Update-Gap)
    // -------------------------------------------------------------------------
    function isValidDevice(data) {
      return data.keys().hasAll(['deviceName', 'bluetoothConnected', 'lastUpdated'])
          // Ensure all fields have correct data types and semantic sizes
          && data.deviceName is string
          && data.deviceName.size() > 0
          && data.deviceName.size() <= 100
          && data.bluetoothConnected is bool
          && (!data.keys().hasAny(['bluetoothPoweredOn']) || data.bluetoothPoweredOn is bool)
          && (!data.keys().hasAny(['connectedDevices']) || validateConnectedDevices(data.connectedDevices))
          && (!data.keys().hasAny(['allDevices']) || validateAllDevices(data.allDevices))
          // Strict top-level allowed key check using empty diff. Computes Set of keys and asserts hasOnly
          && data.diff({}).affectedKeys().hasOnly([
               'deviceName', 'bluetoothConnected', 'lastUpdated',
               'bluetoothPoweredOn', 'connectedDevices', 'allDevices'
             ]);
    }

    function isValidCommandType(type) {
      return type is string && (type == 'SET_BLUETOOTH_POWER' || type == 'DISCONNECT_ACCESSORY');
    }

    function isValidCommandStatus(status) {
      return status is string && (status == 'pending' || status == 'acknowledged' || status == 'completed' || status == 'failed' || status == 'unsupported');
    }

    function isValidCommandTransition(from, to) {
      return (from == 'pending' && (to == 'acknowledged' || to == 'completed' || to == 'failed' || to == 'unsupported'))
          || (from == 'acknowledged' && (to == 'completed' || to == 'failed' || to == 'unsupported'));
    }

    function isValidCommand(data) {
      return data.keys().hasAll(['type', 'status', 'requestedAt'])
          && isValidCommandType(data.type)
          && isValidCommandStatus(data.status)
          && data.requestedAt is timestamp
          && (!data.keys().hasAny(['updatedAt']) || data.updatedAt is timestamp)
          && (!data.keys().hasAny(['errorMessage']) || (data.errorMessage is string && data.errorMessage.size() <= 500))
          && (!data.keys().hasAny(['resultMessage']) || (data.resultMessage is string && data.resultMessage.size() <= 500))
          // Specific requirements based on command type
          && (data.type == 'SET_BLUETOOTH_POWER' 
              ? (data.keys().hasAll(['targetPower']) && data.targetPower is bool && !data.keys().hasAny(['accessoryAddress']))
              : true)
          && (data.type == 'DISCONNECT_ACCESSORY'
              ? (data.keys().hasAll(['accessoryAddress']) && isValidMacAddress(data.accessoryAddress) && !data.keys().hasAny(['targetPower']))
              : true)
          // Strict top-level allowed key check using empty diff
          && data.diff({}).affectedKeys().hasOnly([
               'type', 'status', 'requestedAt', 'updatedAt',
               'targetPower', 'accessoryAddress', 'errorMessage', 'resultMessage'
             ]);
    }

    // -------------------------------------------------------------------------
    // Collections
    // -------------------------------------------------------------------------
    match /users/{uid}/devices/{deviceId} {
      // READ: Users can only read their own devices
      allow get: if isVerified() && isValidId(uid) && isValidId(deviceId) && uid == request.auth.uid;
      allow list: if isVerified() && isValidId(uid) && uid == request.auth.uid;

      // CREATE: Users can only create devices for themselves
      allow create: if isVerified() 
                    && isValidId(uid) && uid == request.auth.uid
                    && isValidId(deviceId) 
                    && isValidDevice(incoming())
                    && incoming().lastUpdated == request.time;

      // UPDATE: Only allow explicitly updating allowed fields
      allow update: if isVerified() 
                    && isValidId(uid) && uid == request.auth.uid
                    && isValidId(deviceId) 
                    && isValidDevice(incoming())
                    && (incoming().lastUpdated == request.time || incoming().lastUpdated == existing().lastUpdated)
                    // Action: Update Status (Ensure update cannot introduce arbitrary fields)
                    && incoming().diff(existing()).affectedKeys().hasOnly([
                          'bluetoothConnected', 'lastUpdated', 'deviceName', 'connectedDevices', 
                          'allDevices', 'bluetoothPoweredOn'
                        ]);

      // DELETE: Users can delete their own devices
      allow delete: if isVerified() && isValidId(uid) && uid == request.auth.uid && isValidId(deviceId);

      // COMMANDS: Nested commands subcollection
      match /commands/{commandId} {
        allow read, list: if isVerified() && isValidId(uid) && uid == request.auth.uid && isValidId(deviceId) && isValidId(commandId);
        allow create: if isVerified()
                      && isValidId(uid) && uid == request.auth.uid
                      && isValidId(deviceId)
                      && isValidId(commandId)
                      && isValidCommand(incoming())
                      && incoming().status == 'pending'
                      && incoming().requestedAt == request.time
                      && !incoming().keys().hasAny(['updatedAt', 'errorMessage', 'resultMessage']);
        allow update: if isVerified()
                      && isValidId(uid) && uid == request.auth.uid
                      && isValidId(deviceId)
                      && isValidId(commandId)
                      && isValidCommand(incoming())
                      && incoming().updatedAt == request.time
                      && isValidCommandTransition(existing().status, incoming().status)
                      && incoming().diff(existing()).affectedKeys().hasOnly([
                           'status', 'updatedAt', 'errorMessage', 'resultMessage'
                         ]);
        allow delete: if isVerified() && isValidId(uid) && uid == request.auth.uid && isValidId(deviceId) && isValidId(commandId);
      }
    }
  }
}
